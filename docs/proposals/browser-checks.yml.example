name: Tracelet focused acceptance
on:
  push:
    branches: [qa/tracelet-20261105]
permissions:
  contents: read
jobs:
  acceptance:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      TRACELET_PREPARATION_SHA: PREPARATION_SHA_REPLACED_BY_ROOT
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24.21.0
      - name: Execute bounded authored checks
        run: python3 scripts/browser-ci.py
